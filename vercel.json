{
    "buildCommand": "echo 'No build needed for static site'",
    "installCommand": "echo 'No install needed'",
    "outputDirectory": ".",
    "public": true,
    "env": {},
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "SAMEORIGIN"
                }
            ]
        }
    ]
}